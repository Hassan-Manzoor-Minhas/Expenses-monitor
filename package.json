{
  "name": "expense-tracker-web-application",
  "version": "1.0.0",
  "description": "Full-stack Expense Tracker Web Application",
  "private": true,
  "scripts": {
    "dev": "npx --yes concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start"
  }
}
